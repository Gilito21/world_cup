# Supabase - obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Football Data API - regístrate gratis en: https://www.football-data.org/
# Para los scripts de seed y actualización de resultados (NO exponer en frontend)
FOOTBALL_API_KEY=tu-api-key

# También necesario para los scripts (usa la service_role key, NO la anon key)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_URL=https://tu-proyecto.supabase.co

# Resend - recordatorios por email (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# URL pública de tu app en Render (sin barra final)
APP_URL=https://tu-app.onrender.com
# Dirección de envío - necesita dominio verificado en Resend
# Para pruebas puedes usar: onboarding@resend.dev (solo envía a tu email de Resend)
FROM_EMAIL=Porra Mundial <porra@tudominio.com>
